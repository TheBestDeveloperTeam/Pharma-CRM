APP_ENV=local
APP_DEBUG=true
APP_URL=http://crm
APP_TIMEZONE=Asia/Kolkata
APP_KEY=base64:GENERATE_WITH_cli/keys.php

DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm
DB_USER=root
DB_PASSWORD=

JWT_KEY_K1=GENERATE_WITH_cli/keys.php
JWT_KEY_K0=
JWT_ACCESS_TTL=900

STORAGE_PATH=storage
LOG_LEVEL=debug

# Notification provider (optional — LogAdapter used if empty)
WHATSAPP_API_KEY=
WHATSAPP_SENDER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
